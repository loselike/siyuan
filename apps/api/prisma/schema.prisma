generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  EXPRESS
  SMALL_PACKET
  DEDICATED_LINE
}

enum ShipmentStatus {
  DRAFT
  DECLARED
  WAITING_RECEIVE
  WAITING_SORT
  WAITING_DISPATCH
  WAITING_ONLINE
  WAITING_SIGNED
  WAITING_RETURN
  PROBLEM
  STUCK
  SIGNED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  roleId       String
  customerId   String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  role         Role     @relation(fields: [roleId], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  loginLogs    LoginLog[]
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  users       User[]
  permissions Permission[]
}

model Permission {
  id     String @id @default(cuid())
  code   String @unique
  roles  Role[]
}

model Department {
  id      String @id @default(cuid())
  name    String
  enabled Boolean @default(true)
}

model Customer {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  enabled   Boolean           @default(true)
  users     User[]
  contacts  CustomerContact[]
  accounts  CustomerAccount[]
  shipments Shipment[]
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  phone      String?
  email      String?
  enabled    Boolean  @default(true)
  customer   Customer @relation(fields: [customerId], references: [id])
}

model CustomerAccount {
  id         String   @id @default(cuid())
  customerId String
  balance    Decimal  @default(0)
  currency   String   @default("CNY")
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Agent {
  id        String     @id @default(cuid())
  name      String
  enabled   Boolean    @default(true)
  shipments Shipment[]
}

model Carrier {
  id       String    @id @default(cuid())
  name     String
  enabled  Boolean   @default(true)
  channels Channel[]
}

model Channel {
  id        String     @id @default(cuid())
  name      String
  carrierId String
  enabled   Boolean    @default(true)
  volumeDivisor Int     @default(5000)
  roundingRule  String  @default("NONE")
  carrier   Carrier    @relation(fields: [carrierId], references: [id])
  shipments Shipment[]
  pricingRules PricingRule[]
}

model Shipment {
  id                  String            @id @default(cuid())
  customerId          String
  agentId             String?
  channelId           String?
  customerOrderNo     String
  systemOrderNo       String            @unique
  transferNo          String?
  businessType        BusinessType
  status              ShipmentStatus
  destinationCountry  String
  packageType         String
  packageCount        Int               @default(1)
  receivableWeightKg  Decimal
  agentWeightKg       Decimal
  latestTracking      String?
  trackingStaleDays   Int               @default(0)
  isRemoteArea        Boolean           @default(false)
  paymentAmountUsd    Decimal?
  paymentAmountCny    Decimal?
  paymentMethod       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  customer            Customer          @relation(fields: [customerId], references: [id])
  agent               Agent?            @relation(fields: [agentId], references: [id])
  channel             Channel?          @relation(fields: [channelId], references: [id])
  packages            ShipmentPackage[]
  events              ShipmentEvent[]
  trackingEvents      TrackingEvent[]
  problemTickets      ProblemTicket[]
  receivableFees      ReceivableFee[]
  payableFees         PayableFee[]
  labels              ShipmentLabel[]
  carrierTasks        CarrierTask[]
}

model ShipmentLabel {
  id          String    @id @default(cuid())
  shipmentId  String
  carrier     String
  channelName String
  labelNo     String    @unique
  transferNo  String
  labelUrl    String
  status      String
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?
  shipment    Shipment  @relation(fields: [shipmentId], references: [id])
}

model CarrierTask {
  id          String    @id @default(cuid())
  shipmentId  String
  type        String
  carrier     String
  transferNo  String
  status      String
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  shipment    Shipment  @relation(fields: [shipmentId], references: [id])
}

model ShipmentPackage {
  id          String   @id @default(cuid())
  shipmentId  String
  lengthCm    Decimal
  widthCm     Decimal
  heightCm    Decimal
  actualKg    Decimal
  volumeKg    Decimal
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  fromStatus ShipmentStatus?
  toStatus   ShipmentStatus
  note       String?
  createdAt  DateTime       @default(now())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id])
}

model TrackingEvent {
  id                String   @id @default(cuid())
  shipmentId         String
  status             String
  happenedAt         DateTime
  visibleToCustomer  Boolean  @default(true)
  shipment           Shipment @relation(fields: [shipmentId], references: [id])
}

model ProblemTicket {
  id                String         @id @default(cuid())
  shipmentId         String
  reason             String
  status             String
  customerVisible    Boolean        @default(true)
  createdAt          DateTime       @default(now())
  closedAt           DateTime?
  shipment           Shipment       @relation(fields: [shipmentId], references: [id])
  replies            ProblemReply[]
}

model ProblemReply {
  id        String        @id @default(cuid())
  ticketId  String
  author    String
  message   String
  createdAt DateTime      @default(now())
  ticket    ProblemTicket @relation(fields: [ticketId], references: [id])
}

model PriceProduct {
  id      String      @id @default(cuid())
  name    String
  enabled Boolean     @default(true)
  zones   PriceZone[]
  rules   PriceRule[]
}

model PriceZone {
  id        String       @id @default(cuid())
  productId String
  name      String
  countries String[]
  product   PriceProduct @relation(fields: [productId], references: [id])
}

model PriceRule {
  id            String       @id @default(cuid())
  productId     String
  zoneName      String
  minWeightKg   Decimal
  maxWeightKg   Decimal
  ratePerKg     Decimal
  product       PriceProduct @relation(fields: [productId], references: [id])
}

model PricingRule {
  id                 String   @id @default(cuid())
  channelId          String
  destinationCountry String
  minWeightKg        Decimal
  maxWeightKg        Decimal
  ratePerKg          Decimal
  currency           String
  enabled            Boolean  @default(true)
  channel            Channel  @relation(fields: [channelId], references: [id])
}

model PriceBook {
  id         String         @id @default(cuid())
  fileName   String
  remark     String?
  importedAt DateTime       @default(now())
  deletedAt  DateTime?
  rows       PriceBookRow[]
}

model PriceBookRow {
  id                 String    @id @default(cuid())
  priceBookId        String
  agentName          String
  carrierName        String?
  sourceSheetName    String?
  channelName        String
  businessRouteName  String?
  realChannelName    String?
  warehouseCode      String?
  destinationCountry String
  minWeightKg        Decimal
  maxWeightKg        Decimal
  costPerKg          Decimal
  currency           String
  transitDays        Int?
  transitLabel       String?
  quoteSourceType    String?
  surchargeFee       Decimal?
  surchargeDetails   Json?
  priceBook          PriceBook @relation(fields: [priceBookId], references: [id])
}

model AgentMarkupRule {
  id                 String   @id @default(cuid())
  agentName          String
  channelName        String?
  realChannelName    String?
  destinationCountry String?
  markupPerKg        Decimal
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WarehousePackage {
  id                        String    @id @default(cuid())
  customerCode              String
  customerOrderNo           String
  domesticTrackingNo        String
  combinedOrderNo           String
  systemOrderNo             String?
  shipmentId                String?
  receivingChannel          String
  destinationCountry        String?
  expectedTotalPackageCount Int?
  packageCount              Int       @default(1)
  weightKg                  Decimal
  lengthCm                  Decimal
  widthCm                   Decimal
  heightCm                  Decimal
  cbm                       Decimal
  volumetricWeightKg        Decimal
  chargeableWeightKg        Decimal
  divisor                   Int       @default(5000)
  roundingRule              String    @default("NONE")
  scanTime                  DateTime?
  status                    String    @default("RECEIVED")
  exceptions                String[]
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  consolidationItems        WarehouseConsolidationItem[]
}

model WarehouseConsolidation {
  id                       String    @id @default(cuid())
  consolidationNo          String    @unique
  mode                     String
  shipmentId               String?
  systemOrderNo            String?
  totalPackages            Int
  totalActualWeightKg      Decimal
  totalVolumetricWeightKg  Decimal
  totalChargeableWeightKg  Decimal
  createdAt                DateTime  @default(now())
  items                    WarehouseConsolidationItem[]
}

model WarehouseConsolidationItem {
  id              String @id @default(cuid())
  consolidationId String
  packageId       String
  consolidation   WarehouseConsolidation @relation(fields: [consolidationId], references: [id])
  package         WarehousePackage @relation(fields: [packageId], references: [id])

  @@unique([consolidationId, packageId])
}

model Surcharge {
  id      String  @id @default(cuid())
  name    String
  amount  Decimal
  enabled Boolean @default(true)
}

model FuelRate {
  id        String   @id @default(cuid())
  channelId String
  rate      Decimal
  activeAt  DateTime
}

model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal
  activeAt      DateTime
  enabled       Boolean  @default(true)
}

model ReceivableFee {
  id         String   @id @default(cuid())
  shipmentId String
  amount     Decimal
  name       String
  settled    Boolean  @default(false)
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
}

model PayableFee {
  id         String   @id @default(cuid())
  shipmentId String
  amount     Decimal
  name       String
  settled    Boolean  @default(false)
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
}

model CustomerStatement {
  id         String   @id @default(cuid())
  customerId String
  total      Decimal
  status     String
  createdAt  DateTime @default(now())
}

model AgentStatement {
  id        String   @id @default(cuid())
  agentId   String
  total     Decimal
  status    String
  createdAt DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  partyType String
  partyId   String
  amount    Decimal
  createdAt DateTime @default(now())
}

model Settlement {
  id        String   @id @default(cuid())
  paymentId String
  feeId     String
  amount    Decimal
  createdAt DateTime @default(now())
}

model AccountLedger {
  id        String   @id @default(cuid())
  partyType String
  partyId   String
  amount    Decimal
  balance   Decimal
  note      String?
  createdAt DateTime @default(now())
}

model ImportJob {
  id        String   @id @default(cuid())
  type      String
  status    String
  createdAt DateTime @default(now())
}

model ExportJob {
  id        String   @id @default(cuid())
  type      String
  status    String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  username  String
  ip        String
  region    String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
