  amount    Decimal
  createdAt DateTime @default(now())
}

model AccountLedger {
  id        String   @id @default(cuid())
  partyType String
  partyId   String
  amount    Decimal
  balance   Decimal
  note      String?
  createdAt DateTime @default(now())
  waterReceipts WaterReceipt[]
}

model WaterReceipt {
  id              String   @id @default(cuid())
  receiptNo       String   @unique
  site            String   @default("思远收款")
  customerId      String?
  customerCode    String?
  customerName    String?
  salesperson     String?
  receiptMethod   String?
  receiptDate     DateTime
  currency        String   @default("RMB")
  amount          Decimal
  matchedAmount   Decimal  @default(0)
  balance         Decimal
  paymentNo       String?
  status          String   @default("PENDING")
  remark          String?
  arrivedAt       DateTime?
  arrivedBy       String?
  archivedAt      DateTime?
  archivedBy      String?
  voidedAt        DateTime?
  voidedBy        String?
  voidedReason    String?
  adjustReason    String?
  accountLedgerId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer? @relation(fields: [customerId], references: [id])
  accountLedger   AccountLedger? @relation(fields: [accountLedgerId], references: [id])
  matches         WaterReceiptMatch[]
  voucher         WaterReceiptVoucher?

  @@index([status, receiptDate])
  @@index([customerId, receiptDate])
  @@index([receiptNo])
}

model WaterReceiptMatch {
  id                      String   @id @default(cuid())
  waterReceiptId           String
  receivableFinanceItemId  String
  shipmentId               String
  amount                   Decimal
  source                   String   @default("MANUAL")
  voided                   Boolean  @default(false)
  voidedAt                 DateTime?
  voidedBy                 String?
  voidReason               String?
  createdAt                DateTime @default(now())
  waterReceipt             WaterReceipt @relation(fields: [waterReceiptId], references: [id])
  receivableFinanceItem    ShipmentFinanceItem @relation(fields: [receivableFinanceItemId], references: [id])
  shipment                 Shipment @relation(fields: [shipmentId], references: [id])

  @@index([waterReceiptId, createdAt])
  @@index([receivableFinanceItemId, voided])
  @@index([shipmentId])
}

model WaterReceiptVoucher {
  id             String   @id @default(cuid())
  waterReceiptId String   @unique
  fileName       String
  mimeType       String?
  sizeBytes      Int?
  url            String?
  uploadedBy     String?
  createdAt      DateTime @default(now())
  waterReceipt   WaterReceipt @relation(fields: [waterReceiptId], references: [id])

  @@index([waterReceiptId, createdAt])
}

