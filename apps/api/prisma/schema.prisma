  id         String   @id @default(cuid())
  customerId String
  total      Decimal
  status     String
  createdAt  DateTime @default(now())
}

model AgentStatement {
  id        String   @id @default(cuid())
  agentId   String
  total     Decimal
  status    String
  createdAt DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  partyType String
  partyId   String
  amount    Decimal
  createdAt DateTime @default(now())
}

model Settlement {
  id        String   @id @default(cuid())
  paymentId String
