generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  EXPRESS
  SMALL_PACKET
  DEDICATED_LINE
}

enum ShipmentStatus {
  DRAFT
  REVIEW_PENDING
  DECLARED
  WAITING_RECEIVE
  WAITING_SORT
  WAITING_DISPATCH
  OUTBOUNDED
  WAITING_DEPARTURE
  DEPARTED
  ARRIVED_PORT
  DELIVERING
  WAITING_ONLINE
  WAITING_SIGNED
  WAITING_RETURN
  PROBLEM
  STUCK
  SIGNED
  REVIEW_REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  roleId       String
  customerId   String?
  name         String?
  phone        String?
  gender       String?
  nickname     String?
  departmentId String?
  site         String?
  mustChangePassword Boolean @default(false)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  role         Role     @relation(fields: [roleId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  customer     Customer? @relation(fields: [customerId], references: [id])
  loginLogs    LoginLog[]
  moduleReadStates UserModuleReadState[]
}

model UserModuleReadState {
  id         String   @id @default(cuid())
  userId     String
  moduleKey  String
  sectionKey String   @default("")
  readAt     DateTime @default(now())
  watermark  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey, sectionKey])
  @@index([userId, moduleKey])
}

model Role {
  id            String       @id @default(cuid())
  name          String       @unique
  label         String?
  description   String?
  site          String?
  sortOrder     Int          @default(0)
  enabled       Boolean      @default(true)
  systemBuiltin Boolean      @default(false)
  users         User[]
  permissions   Permission[]
}

model Permission {
  id     String @id @default(cuid())
  code   String @unique
  roles  Role[]
}

model Department {
  id      String @id @default(cuid())
  name    String
  enabled Boolean @default(true)
  users   User[]
}

model Customer {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  customerSource String?
  salesperson String?
  defaultSettlementMethod String?
  enabled   Boolean           @default(true)
  users     User[]
  contacts  CustomerContact[]
  accounts  CustomerAccount[]
  shipments Shipment[]
  waterReceipts WaterReceipt[]
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  company    String?
  phone      String?
  email      String?
  fbaWarehouseCode String?
  address    String?
  country    String?
  state      String?
  postalCode String?
  enabled    Boolean  @default(true)
  customer   Customer @relation(fields: [customerId], references: [id])
}

model CustomerAccount {
  id         String   @id @default(cuid())
  customerId String
  balance    Decimal  @default(0)
  currency   String   @default("RMB")
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Agent {
  id        String     @id @default(cuid())
  name      String
  code      String?
  shortName String?
  integrationType String @default("MANUAL")
  warehouseAddress1 String?
  warehouseAddress2 String?
  warehouseAddress3 String?
  warehouseContact String?
  invoiceTemplateName String?
  invoiceTemplateUrl String?
  trackingWebsite String?
  createdAt DateTime @default(now())
  enabled   Boolean    @default(true)
  shipments Shipment[]
  bankAccounts AgentBankAccount[]
  payeeBankAccounts PayeeBankAccount[]
  agentChannels AgentChannel[]
}

model AgentChannel {
  id          String  @id @default(cuid())
  agentId     String
  channelName String
  enabled     Boolean @default(true)
  agent       Agent   @relation(fields: [agentId], references: [id])

  @@index([agentId])
}

model Carrier {
  id       String    @id @default(cuid())
  name     String
  enabled  Boolean   @default(true)
  channels Channel[]
}

model Channel {
  id        String     @id @default(cuid())
  name      String
  carrierId String
  enabled   Boolean    @default(true)
  volumeDivisor Int     @default(5000)
  roundingRule  String  @default("NONE")
  businessType String @default("EXPRESS")
  category String @default("DHL")
  multiPieceWeightRule String @default("SUM_THEN_COMPARE")
  singleWeightRoundingRule String @default("ACTUAL")
  settlementWeightRule String @default("MAX_ACTUAL_VOLUME")
  settlementWeightRoundingRule String @default("NONE")
  largeCargoThresholdKg Decimal?
  remoteAreaRule String @default("NONE")
  carrier   Carrier    @relation(fields: [carrierId], references: [id])
  shipments Shipment[]
  pricingRules PricingRule[]
}

model ChannelCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id        String   @id @default(cuid())
  sortOrder Int      @default(0)
  name      String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, name])
}

model Shipment {
  id                  String            @id @default(cuid())
  customerId          String
  agentId             String?
  channelId           String?
  customerOrderNo     String
  systemOrderNo       String            @unique
  transferNo          String?
  subOrderNo          String?
  inboundNo           String?
  productName         String?
  declarationRequired Boolean           @default(false)
  sensitive           Boolean           @default(false)
  cargoType           String?
  volumeCbm           Decimal?
  actualWeightKg      Decimal?
  cargoDataSource     String            @default("AUTO_MATCHED")
  chargeWeightOverridden Boolean         @default(false)
  settlementMethod    String?
  tradeTerms          String?
  fbaInboundNo        String?
  receiverName        String?
  receiverCompany     String?
  receiverPhone       String?
  receiverAddress     String?
  receiverCountry     String?
  receiverState       String?
  receiverPostalCode  String?
  fbaWarehouseCode    String?
  entryBy             String?
  entryAt             DateTime?
  businessReviewedBy  String?
  businessReviewedAt  DateTime?
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewRejectedReason String?
  businessType        BusinessType
  status              ShipmentStatus
  destinationCountry  String
  packageType         String
  packageCount        Int               @default(1)
  receivableWeightKg  Decimal
  agentWeightKg       Decimal
  latestTracking      String?
  trackingStaleDays   Int               @default(0)
  isRemoteArea        Boolean           @default(false)
  paymentAmountUsd    Decimal?
  paymentAmountCny    Decimal?
  paymentMethod       String?
  shippingMarkRequired Boolean          @default(false)
  businessInvoiceName String?
  businessInvoiceUrl  String?
  businessInvoiceUploadedBy String?
  businessInvoiceUploadedAt DateTime?
  outboundAt          DateTime?
  etaAt               DateTime?
  etdAt               DateTime?
  remark              String?
  draftWarehousePackageIds String[]          @default([])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  deletedBy           String?
  deletedReason       String?
  deleteType          String?
  restoredAt          DateTime?
  restoredBy          String?
  restoreMode         String?
  customer            Customer          @relation(fields: [customerId], references: [id])
  agent               Agent?            @relation(fields: [agentId], references: [id])
  channel             Channel?          @relation(fields: [channelId], references: [id])
  packages            ShipmentPackage[]
  events              ShipmentEvent[]
  trackingEvents      TrackingEvent[]
  problemTickets      ProblemTicket[]
  receivableFees      ReceivableFee[]
  payableFees         PayableFee[]
  financeItems        ShipmentFinanceItem[]
  payablePaymentApplications PayablePaymentApplication[]
  paymentApplicationItems PaymentApplicationItem[]
  waterReceiptMatches WaterReceiptMatch[]
  labels              ShipmentLabel[]
  carrierTasks        CarrierTask[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([deletedAt, createdAt])
}

model ShipmentLabel {
  id          String    @id @default(cuid())
  shipmentId  String
  carrier     String
  channelName String
  labelNo     String    @unique
  transferNo  String
  labelUrl    String
  status      String
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?
  shipment    Shipment  @relation(fields: [shipmentId], references: [id])
}

model CarrierTask {
  id          String    @id @default(cuid())
  shipmentId  String
  type        String
  carrier     String
  transferNo  String
  status      String
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  shipment    Shipment  @relation(fields: [shipmentId], references: [id])
}

model ShipmentPackage {
  id          String   @id @default(cuid())
  shipmentId  String
  lengthCm    Decimal
  widthCm     Decimal
  heightCm    Decimal
  actualKg    Decimal
  volumeKg    Decimal
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  fromStatus ShipmentStatus?
  toStatus   ShipmentStatus
  note       String?
  createdAt  DateTime       @default(now())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id])
}

model TrackingEvent {
  id                String   @id @default(cuid())
  shipmentId         String
  status             String
  happenedAt         DateTime
  visibleToCustomer  Boolean  @default(true)
  location           String?
  carrier            String?
  transferNo         String?
  rawContent         String?
  source             String   @default("MANUAL_ENTRY")
  kind               String   @default("LOGISTICS")
  shipment           Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, kind, happenedAt])
}

model ProblemTicket {
  id                String         @id @default(cuid())
  shipmentId         String
  reason             String
  status             String
  customerVisible    Boolean        @default(true)
  createdAt          DateTime       @default(now())
  closedAt           DateTime?
  closedBy           String?
  closeReason        String?
  assistanceReason   String?
  assistanceAt       DateTime?
  tagSnapshot        Json?
  shipment           Shipment       @relation(fields: [shipmentId], references: [id])
  replies            ProblemReply[]
}

model CommonTag {
  id                     String   @id @default(cuid())
  name                   String
  scene                  String
  enabled                Boolean  @default(true)
  customerVisibleAllowed Boolean  @default(true)
  sortOrder              Int      @default(0)
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  @@unique([scene, name])
  @@index([scene, enabled, sortOrder])
}

model ProblemReply {
  id        String        @id @default(cuid())
  ticketId  String
  author    String
  message   String
  createdAt DateTime      @default(now())
  ticket    ProblemTicket @relation(fields: [ticketId], references: [id])
}

model PriceProduct {
  id      String      @id @default(cuid())
  name    String
  enabled Boolean     @default(true)
  zones   PriceZone[]
  rules   PriceRule[]
}

model PriceZone {
  id        String       @id @default(cuid())
  productId String
  name      String
  countries String[]
  product   PriceProduct @relation(fields: [productId], references: [id])
}

model PriceRule {
  id            String       @id @default(cuid())
  productId     String
  zoneName      String
  minWeightKg   Decimal
  maxWeightKg   Decimal
  ratePerKg     Decimal
  product       PriceProduct @relation(fields: [productId], references: [id])
}

model PricingRule {
  id                 String   @id @default(cuid())
  channelId          String
  destinationCountry String
  minWeightKg        Decimal
  maxWeightKg        Decimal
  ratePerKg          Decimal
  currency           String
  enabled            Boolean  @default(true)
  channel            Channel  @relation(fields: [channelId], references: [id])
}

model PriceBook {
  id                 String         @id @default(cuid())
  fileName           String
  agentId            String?
  agentShortName     String?
  targetModule       String?
  remark             String?
  // The parser/normalizer revision used to build the current rows. A new
  // revision is rebuilt from the retained original file by the background
  // worker; it never requires an operator to upload the workbook again.
  parserRuleVersion  Int            @default(0)
  refreshStatus      String         @default("CURRENT")
  lastRuleRefreshAt  DateTime?
  importedAt         DateTime       @default(now())
  deletedAt          DateTime?
  rows               PriceBookRow[]
  legacySources      LegacyPricingSource[]

  @@index([deletedAt, targetModule, importedAt])
  @@index([deletedAt, targetModule, parserRuleVersion])
}

model PriceBookImportJob {
  id             String    @id @default(cuid())
  fileName       String
  agentId        String?
  agentShortName String?
  status         String    @default("PENDING")
  filePath       String?
  priceBookId    String?
  targetModule   String?
  // IMPORT is the user upload flow. RULE_REFRESH is an idempotent,
  // server-side rebuild from the retained original workbook.
  kind           String    @default("IMPORT")
  parserRuleVersion Int?
  dedupeKey      String?   @unique
  totalRows      Int       @default(0)
  processedRows  Int       @default(0)
  failedRows     Int       @default(0)
  message        String?
  errorSummary   Json?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([status, createdAt])
  @@index([priceBookId])
  @@index([kind, status, createdAt])
}

model DubaiPriceDisplayVersion {
  id           String   @id @default(cuid())
  priceBookId  String?
  originalName String
  status       String   @default("PROCESSING")
  isActive     Boolean  @default(false)
  isActiveAir  Boolean  @default(false)
  isActiveSea  Boolean  @default(false)
  salesSafe    Boolean  @default(false)
  message      String?
  unassignedSheets Json?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pages        DubaiPriceDisplayPage[]

  @@index([isActive, status, createdAt])
  @@index([isActiveAir, status, updatedAt])
  @@index([isActiveSea, status, updatedAt])
  @@index([priceBookId])
}

model DubaiPriceDisplayPage {
  id        String   @id @default(cuid())
  versionId String
  mode      String
  sheetName String
  pageNo    Int
  fileName  String
  mimeType  String   @default("image/png")
  sizeBytes Int
  createdAt DateTime @default(now())
  version   DubaiPriceDisplayVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, sheetName, pageNo])
  @@index([versionId, mode, sheetName, pageNo])
}

model PriceBookRow {
  id                 String    @id @default(cuid())
  priceBookId        String
  agentName          String
  carrierName        String?
  sourceSheetName    String?
  channelName        String
  businessRouteName  String?
  realChannelName    String?
  warehouseCode      String?
  destinationCountry String
  postalRule        String?
  minWeightKg        Decimal
  maxWeightKg        Decimal
  costPerKg          Decimal
  currency           String
  transitDays        Int?
  transitLabel       String?
  quoteSourceType    String?
  surchargeFee       Decimal?
  surchargeDetails   Json?
  productSurchargeRemark String?
  specialRemark      String?
  priceBook          PriceBook @relation(fields: [priceBookId], references: [id])

  @@index([priceBookId])
  @@index([destinationCountry, minWeightKg, maxWeightKg])
  @@index([destinationCountry, postalRule])
  @@index([warehouseCode, destinationCountry])
  @@index([priceBookId, destinationCountry, minWeightKg])
  @@index([destinationCountry, warehouseCode, minWeightKg])
}

model LegacyPricingSource {
  id         String             @id @default(cuid())
  priceBookId String?
  module     String
  fileName   String
  rowCount   Int                @default(0)
  status     String             @default("ok")
  message    String?
  importedAt DateTime           @default(now())
  deletedAt  DateTime?
  rows       LegacyPricingRow[]
  priceBook  PriceBook?         @relation(fields: [priceBookId], references: [id])

  @@index([module, deletedAt, importedAt])
  @@index([priceBookId, deletedAt])
}

model LegacyPricingRow {
  id                 String              @id @default(cuid())
  sourceId           String
  module             String
  agentName          String
  origin             String?
  channelName        String
  serviceName        String?
  warehouseCode      String?
  destinationCountry String?
  postalRule         String?
  minWeightKg        Decimal?
  maxWeightKg        Decimal?
  costPerKg          Decimal?
  cbmPrice           Decimal?
  tierLabel          String?
  transitLabel       String?
  productSurchargeRemark String?
  specialRemark      String?
  remark             String?
  raw                Json
  source             LegacyPricingSource @relation(fields: [sourceId], references: [id])

  @@index([module, agentName])
  @@index([module, warehouseCode])
  @@index([module, destinationCountry])
  @@index([sourceId, module])
  @@index([sourceId, agentName, minWeightKg])
  @@index([sourceId, channelName])
  @@index([sourceId, destinationCountry, minWeightKg])
  @@index([module, destinationCountry, minWeightKg])
  @@index([module, agentName, minWeightKg])
  @@index([module, warehouseCode, minWeightKg])
}

model AgentMarkupRule {
  id                 String   @id @default(cuid())
  legacyModule       String?
  priceBookId        String?
  agentName          String
  channelName        String?
  realChannelName    String?
  destinationCountry String?
  markupPerKg        Decimal
  markupType         String   @default("WEIGHT")
  markupValue        Decimal  @default(0)
  markupUnit         String?
  minChargeableValue Decimal?
  maxChargeableValue Decimal?
  priority           Int      @default(100)
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  @@index([legacyModule, priceBookId, agentName, enabled, deletedAt])
  @@index([legacyModule, agentName, enabled, deletedAt])
  @@index([priceBookId, agentName, enabled, deletedAt])
  @@index([agentName, enabled, deletedAt])
  @@index([legacyModule, agentName, channelName, markupUnit, enabled, deletedAt])
  @@index([priority])
}

model AgentChannelCustomRemark {
  id              String   @id @default(cuid())
  legacyModule    String
  agentName       String
  channelName     String
  realChannelName String?
  content         String
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([legacyModule, agentName, channelName])
  @@index([legacyModule, agentName, channelName, enabled])
}

model SouthAfricaRateImage {
  id           String    @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String?
  url          String?
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([deletedAt, createdAt])
}

model SouthAfricaRateRule {
  id            String    @id @default(cuid())
  category      String
  name          String
  keywords      String[]
  ratePerCbm    Decimal?
  consult       Boolean   @default(false)
  remark        String?
  sourceImageId String?
  enabled       Boolean   @default(true)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([enabled, deletedAt])
  @@index([category, name])
}

model SouthAfricaLookupPendingReview {
  id             String   @id @default(cuid())
  productName    String
  volumeCbm      Decimal
  actualWeightKg Decimal?
  packageInfo    String?
  createdBy      String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  @@index([status, createdAt])
}

model WarehousePackage {
  id                        String    @id @default(cuid())
  customerCode              String
  customerName              String?
  site                      String?
  salesperson               String?
  customerOrderNo           String
  domesticTrackingNo        String
  combinedOrderNo           String
  labelNo                   String?
  sourcePackageId           String?
  sourcePackageNo           String?
  archivedByPackageId       String?
  archivedByPackageNo       String?
  archivedReason            String?
  archivedAt                DateTime?
  tallyTaskId               String?
  tallyTaskNo               String?
  systemOrderNo             String?
  shipmentId                String?
  receivingChannel          String
  destinationCountry        String?
  expectedTotalPackageCount Int?
  packageIndex              Int?
  packageCount              Int       @default(1)
  weightKg                  Decimal
  lengthCm                  Decimal
  widthCm                   Decimal
  heightCm                  Decimal
  cbm                       Decimal
  volumetricWeightKg        Decimal
  chargeableWeightKg        Decimal
  divisor                   Int       @default(6000)
  roundingRule              String    @default("NONE")
  scanTime                  DateTime?
  remark                    String?
  manualException           String?
  scanSource                String?
  measurementStatus         String    @default("MEASURED")
  measurementMatchedAt      DateTime?
  measurementMatchedBy      String?
  status                    String    @default("RECEIVED")
  exceptions                String[]
  createdBy                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  consolidationItems        WarehouseConsolidationItem[]

  @@index([customerOrderNo, domesticTrackingNo])
  @@index([shipmentId, createdAt])
  @@index([status, scanTime])
  @@index([combinedOrderNo])
  @@index([archivedByPackageId])
  @@index([tallyTaskId])
  @@index([labelNo, measurementStatus])
}

model WarehouseConsolidation {
  id                       String    @id @default(cuid())
  consolidationNo          String    @unique
  mode                     String
  shipmentId               String?
  systemOrderNo            String?
  totalPackages            Int
  totalActualWeightKg      Decimal
  totalVolumetricWeightKg  Decimal
  totalChargeableWeightKg  Decimal
  createdAt                DateTime  @default(now())
  items                    WarehouseConsolidationItem[]
}

model WarehouseConsolidationItem {
  id              String @id @default(cuid())
  consolidationId String
  packageId       String
  consolidation   WarehouseConsolidation @relation(fields: [consolidationId], references: [id])
  package         WarehousePackage @relation(fields: [packageId], references: [id])

  @@unique([consolidationId, packageId])
}

model WarehouseTallyTask {
  id                            String    @id @default(cuid())
  taskNo                        String    @unique
  status                        String    @default("PENDING")
  packageIds                    String[]
  sourcePackageId               String
  sourceCombinedOrderNo         String
  customerCode                  String
  customerName                  String?
  salesperson                   String?
  packageCount                  Int
  originalWeightKg              Decimal
  originalLengthCm              Decimal
  originalWidthCm               Decimal
  originalHeightCm              Decimal
  originalVolumetricWeightKg    Decimal
  originalVolumetricWeightKg5000 Decimal
  tallyRequirement              String
  remark                        String?
  createdBy                     String?
  createdAt                     DateTime  @default(now())
  completedPackageCount         Int?
  completedWeightKg             Decimal?
  completedLengthCm             Decimal?
  completedWidthCm              Decimal?
  completedHeightCm             Decimal?
  completedVolumetricWeightKg   Decimal?
  completedVolumetricWeightKg5000 Decimal?
  completedBy                   String?
  completedAt                   DateTime?
  labelStatus                   String    @default("NOT_GENERATED")
  labelNo                       String?
  labelQrContent                String?
  labelGeneratedAt              DateTime?
  labelGeneratedBy              String?
  labelPrintedAt                DateTime?
  labelPrintedBy                String?
  labelDownloadedAt             DateTime?
  labelDownloadedBy             String?
  appliedPackageId              String?
  appliedPackageNo              String?
  labelAppliedAt                DateTime?
  labelAppliedBy                String?

  @@index([status, createdAt])
  @@index([customerCode, createdAt])
  @@index([sourceCombinedOrderNo])
  @@index([labelNo])
  @@index([appliedPackageId])
}

model Surcharge {
  id      String  @id @default(cuid())
  name    String
  amount  Decimal
  enabled Boolean @default(true)
}

model FuelRate {
  id        String   @id @default(cuid())
  channelId String
  rate      Decimal
  activeAt  DateTime
}

model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal
  activeAt      DateTime
  endAt         DateTime?
  enabled       Boolean  @default(true)
}

model ReceivableFee {
  id                   String   @id @default(cuid())
  shipmentId           String
  amount               Decimal
  name                 String
  settled              Boolean  @default(false)
  currency             String   @default("RMB")
  settlementMethod     String?
  paymentNo            String?
  reconciliationStatus String   @default("PENDING")
  createdBy            String?
  reviewedBy           String?
  reviewedAt           DateTime?
  remark               String?
  voided               Boolean  @default(false)
  voidedAt             DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  shipment             Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, createdAt])
  @@index([voided, reconciliationStatus, createdAt])
}

model PayableFee {
  id         String   @id @default(cuid())
  shipmentId String
  amount     Decimal
  name       String
  settled    Boolean  @default(false)
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
}

model ShipmentFinanceItem {
  id                   String   @id @default(cuid())
  shipmentId           String
  type                 String
  name                 String
  amount               Decimal
  currency             String   @default("RMB")
  settlementMethod     String?
  paymentNo            String?
  reconciliationStatus String   @default("PENDING")
  receivedAmount       Decimal  @default(0)
  receiptStatus        String   @default("UNPAID")
  receiptMatchSource   String?
  receiptMatchHint     String?
  receivedAt           DateTime?
  agentName            String?
  chargeWeightKg       Decimal?
  unitPrice            Decimal?
  amountOverridden     Boolean  @default(false)
  remark               String?
  locked               Boolean  @default(false)
  voided               Boolean  @default(false)
  createdBy            String?
  reviewedBy           String?
  reviewedAt           DateTime?
  voidedAt             DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  shipment             Shipment @relation(fields: [shipmentId], references: [id])
  payablePaymentApplications PayablePaymentApplication[]
  paymentApplicationItems PaymentApplicationItem[]
  waterReceiptMatches WaterReceiptMatch[]

  @@index([shipmentId, type])
  @@index([type, voided, createdAt])
  @@index([reconciliationStatus, createdAt])
  @@index([receiptStatus, createdAt])
}

model AgentBankAccount {
  id            String   @id @default(cuid())
  agentId       String?
  agentName     String
  accountName   String
  bankName      String
  bankAccountNo String
  currency      String   @default("RMB")
  remark        String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agent         Agent?   @relation(fields: [agentId], references: [id])
  paymentApplications PayablePaymentApplication[]

  @@index([agentName, enabled])
  @@index([agentId, enabled])
}

model PayablePaymentApplication {
  id                   String   @id @default(cuid())
  payableFinanceItemId String
  shipmentId           String
  agentBankAccountId   String?
  payeeBankAccountId   String?
  amount               Decimal
  currency             String   @default("RMB")
  paymentNo            String?
  status               String   @default("PENDING")
  applicationStatus    String   @default("PENDING")
  remark               String?
  appliedAt            DateTime?
  invalidatedAt        DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  payableFinanceItem   ShipmentFinanceItem @relation(fields: [payableFinanceItemId], references: [id])
  shipment             Shipment @relation(fields: [shipmentId], references: [id])
  bankAccount          AgentBankAccount? @relation(fields: [agentBankAccountId], references: [id])
  payeeBankAccount     PayeeBankAccount? @relation(fields: [payeeBankAccountId], references: [id])
  attachments          PayableBillAttachment[]
  paymentApplicationItem PaymentApplicationItem?

  @@unique([payableFinanceItemId])
  @@index([status, createdAt])
  @@index([applicationStatus, createdAt])
  @@index([shipmentId])
}

model PayableBillAttachment {
  id                          String   @id @default(cuid())
  payablePaymentApplicationId String
  fileName                    String
  mimeType                    String?
  sizeBytes                   Int?
  url                         String?
  uploadedBy                  String?
  createdAt                   DateTime @default(now())
  payablePaymentApplication   PayablePaymentApplication @relation(fields: [payablePaymentApplicationId], references: [id])

  @@index([payablePaymentApplicationId, createdAt])
}

model PayeeBankAccount {
  id            String   @id @default(cuid())
  agentId       String?
  agentName     String
  accountName   String
  bankName      String
  bankAccountNo String
  currency      String   @default("RMB")
  remark        String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agent         Agent?   @relation(fields: [agentId], references: [id])
  pendingPayments PayablePaymentApplication[]
  paymentApplications PaymentApplication[]

  @@index([agentName, currency, enabled])
  @@index([agentId, currency, enabled])
}

model PaymentApplication {
  id                 String   @id @default(cuid())
  applicationNo      String   @unique
  agentName          String
  currency           String   @default("RMB")
  totalAmount        Decimal
  status             String   @default("WAITING_PAYMENT")
  payeeBankAccountId String?
  remark             String?
  appliedBy          String?
  appliedAt          DateTime @default(now())
  canceledAt         DateTime?
  cancelReason       String?
  payerBankName      String?
  payerBankAccountName String?
  payerBankAccountNo String?
  paidAt             DateTime?
  paidBy             String?
  paidRemark         String?
  reversedAt         DateTime?
  reversedBy         String?
  reverseReason      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  bankAccount        PayeeBankAccount? @relation(fields: [payeeBankAccountId], references: [id])
  items              PaymentApplicationItem[]
  vouchers           PaymentVoucher[]

  @@index([status, appliedAt])
  @@index([status, paidAt])
  @@index([agentName, currency, appliedAt])
}

model PaymentApplicationItem {
  id                           String   @id @default(cuid())
  paymentApplicationId          String
  payablePaymentApplicationId   String   @unique
  payableFinanceItemId          String
  shipmentId                    String
  amount                        Decimal
  currency                      String   @default("RMB")
  createdAt                     DateTime @default(now())
  paymentApplication            PaymentApplication @relation(fields: [paymentApplicationId], references: [id])
  payablePaymentApplication     PayablePaymentApplication @relation(fields: [payablePaymentApplicationId], references: [id])
  payableFinanceItem            ShipmentFinanceItem @relation(fields: [payableFinanceItemId], references: [id])
  shipment                      Shipment @relation(fields: [shipmentId], references: [id])

  @@index([paymentApplicationId])
  @@index([payableFinanceItemId])
}

model PaymentVoucher {
  id                   String   @id @default(cuid())
  paymentApplicationId String?
  pendingPaymentId     String?
  voucherType          String   @default("BILL")
  billNo               String?
  transferNo           String?
  agentName            String?
  billDate             DateTime?
  currency             String?
  billAmount           Decimal?
  status               String   @default("IMPORTED")
  differenceType       String?
  differenceAmount     Decimal?
  differenceReason     String?
  differenceStatus     String?
  differenceHandledBy  String?
  differenceHandledAt  DateTime?
  extraFeeType         String?
  extraFeeAmount       Decimal?
  extraFeeCurrency     String?
  extraFeeAgentName    String?
  extraFeeCustomerCode String?
  extraFeeSystemOrderNo String?
  extraFeeOccurredAt   DateTime?
  extraFeeFinanceItemId String?
  extraFeeRemark       String?
  kuayueBillNo         String?
  kuayueCustomerCode   String?
  kuayueSystemOrderNo  String?
  kuayueAmount         Decimal?
  kuayueCurrency       String?
  kuayueBillDate       DateTime?
  kuayueStatus         String?
  fileName             String
  mimeType             String?
  sizeBytes            Int?
  url                  String?
  uploadedBy           String?
  createdAt            DateTime @default(now())
  paymentApplication   PaymentApplication? @relation(fields: [paymentApplicationId], references: [id])

  @@index([paymentApplicationId, createdAt])
  @@index([pendingPaymentId, createdAt])
  @@index([billNo, agentName])
  @@index([kuayueBillNo, kuayueCustomerCode])
}

model FinanceCatalogItem {
  id        String   @id @default(cuid())
