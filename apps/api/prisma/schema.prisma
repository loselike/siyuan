  partyId   String
  amount    Decimal
  balance   Decimal
  note      String?
  createdAt DateTime @default(now())
  waterReceipt WaterReceipt? @relation("WaterReceiptAccountLedger")
}

model WaterReceipt {
  id              String   @id @default(cuid())
  receiptNo       String   @unique
  site            String   @default("思远收款")
  customerId      String?
  customerCode    String?
  customerName    String?
  salesperson     String?
  receiptMethod   String?
  receiptDate     DateTime
  currency        String   @default("RMB")
  amount          Decimal
  matchedAmount   Decimal  @default(0)
  balance         Decimal
  paymentNo       String?
  paymentNoKey    String?  @unique
  status          String   @default("PENDING")
  remark          String?
  arrivedAt       DateTime?
  arrivedBy       String?
  archivedAt      DateTime?
  archivedBy      String?
  voidedAt        DateTime?
  voidedBy        String?
  voidedReason    String?
  adjustReason    String?
  accountLedgerId String?  @unique
  createdBy       String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer? @relation(fields: [customerId], references: [id])
  accountLedger   AccountLedger? @relation("WaterReceiptAccountLedger", fields: [accountLedgerId], references: [id])
  createdByUser   User? @relation("WaterReceiptCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  matches         WaterReceiptMatch[]
  matchRequests   WaterReceiptMatchRequest[]
  voucher         WaterReceiptVoucher?

  @@index([status, receiptDate])
  @@index([customerId, receiptDate])
  @@index([createdByUserId, receiptDate])
  @@index([receiptNo])
}

model WaterReceiptMatch {
  id                      String   @id @default(cuid())
  waterReceiptId           String
  receivableFinanceItemId  String?
  receivableFeeId          String?
  receivableSourceType     String   @default("MANUAL")
  shipmentId               String
  amount                   Decimal
  rmbAmount                Decimal?
  receivableAmount         Decimal?
  receivableCurrency       String?
  receiptExchangeRate      Decimal?
  receivableExchangeRate   Decimal?
  source                   String   @default("MANUAL")
  voided                   Boolean  @default(false)
  voidedAt                 DateTime?
  voidedBy                 String?
  voidReason               String?
  createdAt                DateTime @default(now())
  waterReceipt             WaterReceipt @relation(fields: [waterReceiptId], references: [id])
  receivableFinanceItem    ShipmentFinanceItem? @relation(fields: [receivableFinanceItemId], references: [id])
  receivableFee            ReceivableFee? @relation(fields: [receivableFeeId], references: [id])
  shipment                 Shipment @relation(fields: [shipmentId], references: [id])

  @@index([waterReceiptId, createdAt])
  @@index([receivableFinanceItemId, voided])
  @@index([receivableFeeId, voided])
  @@index([shipmentId])
}

model WaterReceiptMatchRequest {
  id                      String   @id @default(cuid())
  reviewBatchId           String
  waterReceiptId          String
  receivableFinanceItemId String?
  receivableFeeId         String?
  receivableSourceType    String   @default("MANUAL")
  shipmentId              String
  amount                  Decimal
  rmbAmount               Decimal?
  receivableAmount        Decimal?
  receivableCurrency      String?
  receiptExchangeRate     Decimal?
  receivableExchangeRate  Decimal?
  status                  String   @default("PENDING")
  requestedBy             String
  requestedByUserId       String?
  requestedAt             DateTime @default(now())
  reviewedBy              String?
  reviewedAt              DateTime?
  rejectionReason         String?
  approvedMatchId         String?
  reversedBy              String?
  reversedAt              DateTime?
  reverseReason           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  waterReceipt            WaterReceipt @relation(fields: [waterReceiptId], references: [id])
  receivableFinanceItem   ShipmentFinanceItem? @relation(fields: [receivableFinanceItemId], references: [id])
  receivableFee           ReceivableFee? @relation(fields: [receivableFeeId], references: [id])
  shipment                Shipment @relation(fields: [shipmentId], references: [id])

  @@index([waterReceiptId, status, requestedAt])
  @@index([reviewBatchId, status])
  @@index([receivableFinanceItemId, status])
  @@index([receivableFeeId, status])
  @@index([shipmentId, status])
  @@index([requestedByUserId, status])
}

model WaterReceiptVoucher {
  id             String   @id @default(cuid())
  waterReceiptId String   @unique
  fileName       String
  mimeType       String?
  sizeBytes      Int?
  url            String?
  uploadedBy     String?
  createdAt      DateTime @default(now())
  waterReceipt   WaterReceipt @relation(fields: [waterReceiptId], references: [id])

  @@index([waterReceiptId, createdAt])
}

model ImportJob {
  id        String   @id @default(cuid())
  type      String
  status    String
  createdAt DateTime @default(now())
}

model ExportJob {
  id        String   @id @default(cuid())
  type      String
  status    String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([target, createdAt])
}

model Announcement {
  id                      String   @id @default(cuid())
  requestId               String   @unique
  title                   String
  body                    String
  severity                String   @default("INFO")
  audienceType            String
  audienceValues          Json?
  status                  String   @default("PUBLISHED")
  requiresAcknowledgement Boolean  @default(false)
  expiresAt               DateTime?
  publishedAt             DateTime @default(now())
  withdrawnAt             DateTime?
  createdById             String
  withdrawnById           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  notifications           Notification[]

  @@index([status, publishedAt])
  @@index([createdById, publishedAt])
}

model Notification {
  id                      String   @id @default(cuid())
  kind                    String
  type                    String
  category                String
  severity                String   @default("INFO")
  title                   String
  body                    String
  actorId                 String?
  actorName               String?
  sourceType              String?
  sourceId                String?
  targetModule            String?
  targetSection           String?
  targetEntityType        String?
  targetEntityId          String?
  dedupeKey               String   @unique
  requiresAcknowledgement Boolean  @default(false)
  expiresAt               DateTime?
  withdrawnAt             DateTime?
  announcementId          String?
  createdAt               DateTime @default(now())
  announcement            Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  deliveries              NotificationDelivery[]

  @@index([category, createdAt])
  @@index([sourceType, sourceId])
  @@index([announcementId])
}

model NotificationDelivery {
  id             String   @id @default(cuid())
  notificationId String
  userId         String?
  deliveredAt    DateTime @default(now())
  readAt         DateTime?
  archivedAt     DateTime?
  acknowledgedAt DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([notificationId, userId])
  @@index([userId, archivedAt, deliveredAt])
  @@index([userId, readAt])
}

model NotificationActionTask {
  id                       String   @id @default(cuid())
  type                     String
  sourceRequestId          String   @unique
  ownerUserId              String
  receivableSourceType     String
  receivableId             String
  waterReceiptId           String
  shipmentId               String?
  title                    String
  body                     String
  targetModule             String
  targetSection            String
  targetEntityType         String
  targetEntityId           String
  status                   String   @default("OPEN")
  openedAt                 DateTime
  resolvedAt               DateTime?
  resolvedByAuditLogId     String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([ownerUserId, status, openedAt])
  @@index([ownerUserId, receivableSourceType, receivableId, status])
}

model NotificationActionTaskWatermark {
  ownerUserId              String
  receivableSourceType     String
  receivableId             String
  lastSubmissionAt         DateTime?
  lastSubmissionAuditLogId String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@id([ownerUserId, receivableSourceType, receivableId])
}

model NotificationEventCursor {
  key            String   @id
  lastCreatedAt  DateTime
  lastAuditLogId String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model NotificationEventProcessing {
  id             String   @id @default(cuid())
  auditLogId     String   @unique
  action         String
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  recipientCount Int      @default(0)
  error          String?
  nextRetryAt    DateTime?
  lockToken      String?
  lockedAt       DateTime?
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nextRetryAt, lockedAt])
  @@index([action, status])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  category  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId, enabled])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  username  String
  ip        String
  region    String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
