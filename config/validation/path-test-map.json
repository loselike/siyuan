{
  "version": 1,
  "rules": [
    {
      "id": "prisma",
      "patterns": ["apps/api/prisma/**"],
      "risk": "MODEL_ESCALATION_REQUIRED",
      "effect": ["npm run test:api:safe -- --run <migration-or-repository-focused-test>"],
      "safety": ["npm run typecheck", "npm run governance:check"]
    },
    {
      "id": "finance-catalog-api",
      "patterns": ["apps/api/src/modules/finance/catalog/**", "packages/shared/src/finance-catalog.ts"],
      "risk": "normal",
      "effect": ["npm run test:api:safe -- --run src/modules/app.finance.e2e.test.ts -t \"keeps finance catalog endpoints stable after moving them out of DataController\""],
      "safety": ["npm run typecheck", "npm run governance:check"]
    },
    {
      "id": "finance-catalog-web",
      "patterns": [
        "apps/web/src/modules/finance/FinanceCatalogPage.tsx",
        "apps/web/src/modules/finance/catalog.ts",
        "apps/web/src/modules/finance/financeCatalogClient.ts",
        "apps/web/src/modules/finance/useFinanceCatalog.tsx"
      ],
      "risk": "normal",
      "effect": ["npm run test:web:safe -- --run src/modules/finance/finance.test.tsx -t \"finance catalog 财务资料支持结算方式货物类型品名横向切换和删除\""],
      "safety": ["npm run typecheck -w @siyuan/web", "npm run governance:check"]
    },
    {
      "id": "problem-ticket",
      "patterns": ["apps/api/src/modules/customer-service/problem-ticket/**", "apps/api/src/modules/customer-service/query/customer-service-query.controller.ts", "apps/web/src/modules/problemTickets/**", "packages/shared/src/problem-ticket.ts"],
      "risk": "permission-and-state-boundary",
      "effect": ["npm run test:api:safe -- --run src/modules/customer-service-query.e2e.test.ts"],
      "safety": ["npm run typecheck", "npm run governance:check"]
    },
    {
      "id": "customer-source",
      "patterns": [
        "apps/api/src/modules/master-data/customer-source/**",
        "apps/web/src/modules/masterData/CustomerSourcesPage.tsx",
        "apps/web/src/modules/masterData/CustomerSourcesPage.test.tsx",
        "apps/web/src/modules/masterData/customerSourceClient.ts",
        "packages/shared/src/customer-source.ts"
      ],
      "risk": "permission-and-audit-boundary",
      "effect": [
        "npm run test:api:safe -- --run src/modules/master-data/customer-source/customer-source.service.test.ts src/modules/master-data/customer-source/customer-source.e2e.test.ts",
        "npm run test:web:safe -- --run src/modules/masterData/CustomerSourcesPage.test.tsx"
      ],
      "safety": ["npm run typecheck", "npm run governance:check"]
    },
    {
      "id": "web-test-harness",
      "patterns": ["apps/web/src/modules/testSupport/**"],
      "risk": "test-only",
      "effect": ["npm run test:web:safe -- --run <closest-domain-test> -t \"<focused-scenario>\""],
      "safety": ["npm run typecheck -w @siyuan/web"]
    },
    {
      "id": "shared",
      "patterns": ["packages/shared/**"],
      "risk": "cross-workspace-contract",
      "effect": ["npm run test:shared:safe -- --run"],
      "safety": ["npm run typecheck"]
    },
    {
      "id": "operations-line-shipment-query-contract",
      "patterns": ["apps/api/src/modules/operations-line-shipment-query.e2e.test.ts"],
      "risk": "permission-and-data-scope-boundary",
      "effect": ["npm run test:api:safe -- --run src/modules/operations-line-shipment-query.e2e.test.ts"],
      "safety": ["npm run typecheck -w @siyuan/api"]
    },
    {
      "id": "tracking-import-command-contract",
      "patterns": ["apps/api/src/modules/tracking-import-command.e2e.test.ts"],
      "risk": "permission-boundary",
      "effect": ["npm run test:api:safe -- --run src/modules/tracking-import-command.e2e.test.ts"],
      "safety": ["npm run typecheck -w @siyuan/api"]
    },
    {
      "id": "warehouse-tally-lifecycle-contract",
      "patterns": ["apps/api/src/modules/warehouse-tally-lifecycle.e2e.test.ts"],
      "risk": "permission-and-state-boundary",
      "effect": ["npm run test:api:safe -- --run src/modules/warehouse-tally-lifecycle.e2e.test.ts"],
      "safety": ["npm run typecheck -w @siyuan/api"]
    },
    {
      "id": "api",
      "patterns": ["apps/api/**"],
      "risk": "normal",
      "effect": ["npm run test:api:safe -- --run <closest-domain-test>"],
      "safety": ["npm run typecheck -w @siyuan/api"]
    },
    {
      "id": "web",
      "patterns": ["apps/web/**"],
      "risk": "normal",
      "effect": ["npm run test:web:safe -- --run <closest-domain-test> -t \"<focused-scenario>\""],
      "safety": ["npm run typecheck -w @siyuan/web"]
    },
    {
      "id": "governance",
      "patterns": ["AGENTS.md", ".codex/**", "scripts/**", "config/architecture/**", "config/validation/**", "docs/dev-thread-rules.md"],
      "risk": "governance",
      "effect": ["npm run governance:check"],
      "safety": ["git diff --check"]
    }
  ]
}
